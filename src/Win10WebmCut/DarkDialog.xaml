<Window x:Class="Win10WebmCut.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komunikat" Width="510" MinWidth="390" MaxWidth="760"
        SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">
  <Border CornerRadius="9" Background="{StaticResource WindowBackground}"
          BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="0">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity=".55"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="{StaticResource HeaderBackground}" Margin="1,1,1,0" Height="48"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TitleText" Text="Komunikat" FontWeight="SemiBold" FontSize="15"
                   Margin="18,0" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="✕" Width="37" Padding="0" Margin="4,5,8,5"
                Click="Close_Click" ToolTip="Zamknij"/>
      </Grid>
      <Grid Grid.Row="1" Margin="20,22,20,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="IconBackground" Height="36" Width="36" CornerRadius="18"
                Background="{StaticResource AccentSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock x:Name="IconText" Text="✓" Foreground="{StaticResource Accent}" FontWeight="Bold"
                     FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ScrollViewer Grid.Column="1" MaxHeight="390" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"
                     FontSize="13.5" VerticalAlignment="Top"/>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12,9"
              CornerRadius="0,0,9,9" Margin="1,0,1,1">
        <Button x:Name="OkButton" Content="OK" MinWidth="102" HorizontalAlignment="Right"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
      </Border>
    </Grid>
  </Border>
</Window>