<Window x:Class="Win10WebmCut.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komunikat" Width="570" MinWidth="390" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}" PreviewKeyDown="Dialog_PreviewKeyDown">
  <Border Margin="10" CornerRadius="8" Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="14" ShadowDepth="3" Opacity="0.5"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource HeaderBackground}" Height="48" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" Margin="18,0" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="1" Content="✕" Width="36" Padding="0" Margin="4,6,8,6" Click="Close_Click" AutomationProperties.Name="Zamknij komunikat"/>
      </Grid>
      <Grid Grid.Row="1" Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="IconBackground" Height="34" Width="34" CornerRadius="17" HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock x:Name="IconText" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
        </Border>
        <TextBox x:Name="MessageText" Grid.Column="1" MaxHeight="350" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0" Padding="2" AutomationProperties.Name="Treść komunikatu — można zaznaczyć i skopiować"/>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="9" CornerRadius="0,0,8,8">
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="Kopiuj bez ścieżek" Click="Copy_Click" ToolTip="Redakcja jest pomocnicza. Sprawdź treść przed udostępnieniem."/>
          <Button x:Name="CancelChoice" Content="Anuluj" IsCancel="True" Visibility="Collapsed" MinWidth="90"/>
          <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="100"
                  Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"/>
        </WrapPanel>
      </Border>
    </Grid>
  </Border>
</Window>
